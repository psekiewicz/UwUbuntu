# UwUbuntu desktop defaults. Users can still change all of it.
#
# Ubuntu's 10_ubuntu-settings override sets most of these in desktop-specific
# sections ([schema:ubuntu], [schema:GNOME-Greeter]), and those always beat
# plain sections no matter which file loads last. So every key is set three
# times: plain (any other session), :ubuntu (the GNOME session) and
# :GNOME-Greeter (the login screen).

# --- Wallpaper ----------------------------------------------------------------
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/uwubuntu/uwubuntu-day.png'
picture-uri-dark='file:///usr/share/backgrounds/uwubuntu/uwubuntu-night.png'
picture-options='zoom'
primary-color='#2b1610'

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/uwubuntu/uwubuntu-day.png'
picture-uri-dark='file:///usr/share/backgrounds/uwubuntu/uwubuntu-night.png'
picture-options='zoom'
primary-color='#2b1610'

[org.gnome.desktop.background:GNOME-Greeter]
picture-uri='file:///usr/share/backgrounds/uwubuntu/uwubuntu-day.png'
picture-uri-dark='file:///usr/share/backgrounds/uwubuntu/uwubuntu-night.png'
picture-options='zoom'
primary-color='#2b1610'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/uwubuntu/uwubuntu-night.png'
primary-color='#2b1610'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/uwubuntu/uwubuntu-night.png'
primary-color='#2b1610'

# --- Look and feel ------------------------------------------------------------
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='orange'
gtk-theme='Yaru-dark'
icon-theme='Yaru'
enable-animations=true

[org.gnome.desktop.interface:ubuntu]
color-scheme='prefer-dark'
accent-color='orange'
gtk-theme='Yaru-dark'
icon-theme='Yaru'
enable-animations=true

[org.gnome.desktop.interface:GNOME-Greeter]
color-scheme='prefer-dark'
accent-color='orange'
gtk-theme='Yaru-dark'
icon-theme='Yaru'

# --- Shell: dock favourites + animation extensions ------------------------------
# Subtle by default: magic lamp + blur. Burn My Windows and wobbly windows are
# installed too and can be switched on in UwU Settings → Animations.
[org.gnome.shell]
favorite-apps=['uwubuntu-installer.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'kitty.desktop', 'org.gnome.Software.desktop', 'org.uwubuntu.Settings.desktop']
enabled-extensions=['compiz-alike-magic-lamp-effect@hermes83.github.com', 'blur-my-shell@aunetx']

[org.gnome.shell:ubuntu]
favorite-apps=['uwubuntu-installer.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'kitty.desktop', 'org.gnome.Software.desktop', 'org.uwubuntu.Settings.desktop']
enabled-extensions=['compiz-alike-magic-lamp-effect@hermes83.github.com', 'blur-my-shell@aunetx']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
transparency-mode='DYNAMIC'

[org.gnome.shell.extensions.dash-to-dock:ubuntu]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
transparency-mode='DYNAMIC'

# --- Login screen (replaces Ubuntu's logo at the bottom) ----------------------
[org.gnome.login-screen]
logo='/usr/share/pixmaps/uwubuntu-logo-gdm.png'

[org.gnome.login-screen:GNOME-Greeter]
logo='/usr/share/pixmaps/uwubuntu-logo-gdm.png'
