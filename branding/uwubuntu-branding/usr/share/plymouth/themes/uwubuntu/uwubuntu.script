// UwUbuntu boot splash: logo, plus paw prints that walk across underneath.

Window.SetBackgroundTopColor(0.17, 0.09, 0.06);
Window.SetBackgroundBottomColor(0.35, 0.16, 0.07);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 60, 10);

PAWS = 6;
SPACING = 52;
paw_image = Image("paw.png");
i = 0;
while (i < PAWS) {
    paw[i] = Sprite(paw_image);
    // alternate up/down like left and right feet
    paw_x = cx - (PAWS - 1) * SPACING / 2 + i * SPACING - paw_image.GetWidth() / 2;
    paw[i].SetPosition(paw_x, cy + 100 + (i % 2) * 16, 10);
    paw[i].SetOpacity(0.12);
    i++;
}

global.tick = 0;
fun refresh_callback() {
    global.tick = global.tick + 1;
    // one new step every ~0.2 s, then a short pause before the walk restarts
    steps = Math.Int(global.tick / 10) % (PAWS + 3);
    j = 0;
    while (j < PAWS) {
        if (j < steps) {
            paw[j].SetOpacity(1);
        } else {
            paw[j].SetOpacity(0.12);
        }
        j++;
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Disk unlock prompt (LUKS) ----------------------------------------------
prompt.sprite = Sprite();
prompt.sprite.SetZ(20);

fun display_password_callback(prompt_text, bullets) {
    line = prompt_text + "  ";
    k = 0;
    while (k < bullets) {
        line = line + "•";
        k++;
    }
    img = Image.Text(line, 0.97, 0.91, 0.87);
    global.prompt.sprite.SetImage(img);
    global.prompt.sprite.SetX(cx - img.GetWidth() / 2);
    global.prompt.sprite.SetY(cy + 170);
    global.prompt.sprite.SetOpacity(1);
}

fun display_normal_callback() {
    global.prompt.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Boot messages -----------------------------------------------------------
message.sprite = Sprite();
message.sprite.SetZ(20);

fun message_callback(text) {
    img = Image.Text(text, 0.94, 0.75, 0.62);
    global.message.sprite.SetImage(img);
    global.message.sprite.SetX(cx - img.GetWidth() / 2);
    global.message.sprite.SetY(Window.GetY() + Window.GetHeight() - 60);
}
Plymouth.SetMessageFunction(message_callback);
