<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>UwUbuntu</vendor>
  <action id="org.uwubuntu.paw-updater.update">
    <description>Install system updates</description>
    <message>Paw Updater needs your password to install updates</message>
    <icon_name>org.uwubuntu.PawUpdater</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/uwubuntu/paw-updater-helper</annotate>
  </action>
</policyconfig>
