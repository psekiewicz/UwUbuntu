#!/bin/sh
# Root half of Paw Updater. Run through pkexec; the polkit action
# org.uwubuntu.paw-updater.update decides who may use it.
set -e
export DEBIAN_FRONTEND=noninteractive

case "${1:-}" in
    refresh)
        apt-get update
        ;;
    update)
        apt-get update
        apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
        ;;
    *)
        echo "usage: $0 refresh|update" >&2
        exit 2
        ;;
esac
