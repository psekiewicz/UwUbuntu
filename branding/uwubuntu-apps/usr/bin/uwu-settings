#!/usr/bin/env python3
"""UwU Settings: the one place to set up UwUbuntu.

UwUbuntu's own options (look, animations, terminal, startup) live here; for
system settings it groups GNOME Settings' panels by topic and opens the right
one, and it links to the other UwUbuntu tools.
"""

import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/uwubuntu")
import uwubuntu_ui as ui  # noqa: E402
from uwubuntu_ui import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.uwubuntu.Settings"
BASHRC = Path.home() / ".bashrc"
FETCH_BEGIN = "# >>> uwubuntu: uwufetch greeting >>>"
FETCH_END = "# <<< uwubuntu: uwufetch greeting <<<"
FETCH_BLOCK = (f"{FETCH_BEGIN}\n"
               "if [ -n \"$PS1\" ] && command -v uwufetch >/dev/null; then uwufetch; fi\n"
               f"{FETCH_END}\n")
AUTO_WALLPAPER = "Automatic (light + dark)"
STARSHIP_TOML = Path(GLib.get_user_config_dir()) / "starship.toml"
STARSHIP_CHOICE = ui.CONFIG_DIR / "starship-preset"
DEFAULT_PRESET = "pastel-powerline"
# (starship preset name, label); all ship with starship itself
STARSHIP_PRESETS = [
    ("pastel-powerline", "Pastel Powerline"),
    ("tokyo-night", "Tokyo Night"),
    ("gruvbox-rainbow", "Gruvbox Rainbow"),
    ("jetpack", "Jetpack"),
    ("nerd-font-symbols", "Nerd Font symbols"),
    ("bracketed-segments", "Bracketed segments"),
    ("plain-text-symbols", "Plain text (no icons)"),
]

# System pages: (page id, title, icon, [(GNOME Settings panel, row title, subtitle)])
SYSTEM_PAGES = [
    ("network", "Network & Bluetooth", "network-wireless-symbolic", [
        ("wifi", "Wi-Fi", "Wireless networks"),
        ("network", "Wired & VPN", "Cables, VPNs and proxies"),
        ("bluetooth", "Bluetooth", "Headphones, mice, controllers"),
    ]),
    ("display", "Display & Sound", "video-display-symbolic", [
        ("display", "Displays", "Resolution, scaling, night light"),
        ("sound", "Sound", "Speakers, microphones, volume"),
        ("power", "Power", "Battery, sleep and power modes"),
    ]),
    ("apps", "Apps & Notifications", "view-app-grid-symbolic", [
        ("applications", "Apps", "Permissions and default apps"),
        ("notifications", "Notifications", "Banners and do-not-disturb"),
        ("search", "Search", "What the overview searches"),
        ("multitasking", "Multitasking", "Workspaces and hot corner"),
    ]),
    ("devices", "Devices", "input-keyboard-symbolic", [
        ("keyboard", "Keyboard", "Layouts and shortcuts"),
        ("mouse", "Mouse & Touchpad", "Speed and gestures"),
        ("printers", "Printers", "Add and manage printers"),
    ]),
    ("privacy", "Privacy & Accounts", "preferences-system-privacy-symbolic", [
        ("privacy", "Privacy & Security", "Screen lock, location, file history"),
        ("online-accounts", "Online Accounts", "Google, Microsoft, Nextcloud…"),
        ("users", "Users", "Accounts and passwords"),
    ]),
    ("system", "System", "computer-symbolic", [
        ("system", "System", "Date & time, language, about this PC"),
        ("universal-access", "Accessibility", "Seeing, hearing, typing"),
    ]),
]

# Tools: (title, subtitle, icon, desktop file id)
TOOLS = [
    ("Paw Updater", "System and app updates", "org.uwubuntu.PawUpdater", "org.uwubuntu.PawUpdater.desktop"),
    ("UwU Monitor", "What your computer is up to", "org.uwubuntu.Monitor", "org.uwubuntu.Monitor.desktop"),
    ("UwCenter", "Get more apps", "org.gnome.Software", "org.gnome.Software.desktop"),
    ("UwU Welcome", "The first-run tour", "org.uwubuntu.Welcome", "org.uwubuntu.Welcome.desktop"),
]


def fetch_greeting_enabled():
    try:
        return FETCH_BEGIN in BASHRC.read_text(encoding="utf-8")
    except OSError:
        return False


def set_fetch_greeting(enabled):
    try:
        text = BASHRC.read_text(encoding="utf-8")
    except OSError:
        text = ""
    if FETCH_BEGIN in text:
        start = text.index(FETCH_BEGIN)
        end = text.find(FETCH_END, start)
        end = len(text) if end == -1 else end + len(FETCH_END) + 1
        text = text[:start] + text[end:]
    if enabled:
        text = text.rstrip("\n") + "\n\n" + FETCH_BLOCK
    BASHRC.write_text(text, encoding="utf-8")


def current_preset():
    try:
        name = STARSHIP_CHOICE.read_text(encoding="utf-8").strip()
    except OSError:
        return DEFAULT_PRESET
    return name or DEFAULT_PRESET


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="UwU Settings")
        self.set_default_size(980, 700)
        self.interface = ui.settings_for("org.gnome.desktop.interface")
        self.background = ui.settings_for("org.gnome.desktop.background")
        self.shell = ui.settings_for("org.gnome.shell", "enabled-extensions")

        # (id, title, icon, section, page widget)
        self.pages = [
            ("look", "Look", "applications-graphics-symbolic", "UwUbuntu", self._page(self._look_group())),
            ("animations", "Animations", "starred-symbolic", "UwUbuntu", self._page(self._animation_group())),
            ("terminal", "Terminal", "utilities-terminal-symbolic", "UwUbuntu",
             self._page(self._terminal_group(), self._prompt_group())),
            ("startup", "Startup", "system-run-symbolic", "UwUbuntu", self._page(self._startup_group())),
        ]
        for page_id, title, icon, panels in SYSTEM_PAGES:
            self.pages.append((page_id, title, icon, "System", self._page(self._panel_group(title, panels))))
        self.pages.append(("tools", "Tools", "applications-utilities-symbolic", "UwUbuntu apps",
                           self._page(self._tools_group())))

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        for page_id, _title, _icon, _section, widget in self.pages:
            self.stack.add_named(widget, page_id)

        self.sidebar = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.sidebar.add_css_class("navigation-sidebar")
        self.sidebar.set_header_func(self._sidebar_header)
        for page_id, title, icon, section, _widget in self.pages:
            box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=title, xalign=0))
            row = Gtk.ListBoxRow(child=box)
            row.page_id, row.page_title, row.section = page_id, title, section
            self.sidebar.append(row)
        self.sidebar.connect("row-activated", self._on_row_activated)

        about = Gtk.Button(icon_name="help-about-symbolic", tooltip_text="About UwUbuntu")
        about.connect("clicked", self._show_about)
        sidebar_header = Adw.HeaderBar()
        sidebar_header.pack_end(about)
        sidebar_view = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=self.sidebar,
                                                                  hscrollbar_policy=Gtk.PolicyType.NEVER))
        sidebar_view.add_top_bar(sidebar_header)

        content_view = Adw.ToolbarView(content=self.stack)
        content_view.add_top_bar(Adw.HeaderBar())
        self.content_page = Adw.NavigationPage(title="Look", child=content_view)

        self.split = Adw.NavigationSplitView(
            sidebar=Adw.NavigationPage(title="UwU Settings", child=sidebar_view),
            content=self.content_page)
        breakpoint = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 640sp"))
        breakpoint.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(breakpoint)

        self.toasts = Adw.ToastOverlay(child=self.split)
        self.set_content(self.toasts)
        self.sidebar.select_row(self.sidebar.get_row_at_index(0))

    # --- layout helpers -----------------------------------------------------------
    @staticmethod
    def _page(*groups):
        page = Adw.PreferencesPage()
        for group in groups:
            page.add(group)
        return page

    @staticmethod
    def _sidebar_header(row, before):
        if before is None or before.section != row.section:
            label = Gtk.Label(label=row.section, xalign=0, margin_start=12,
                              margin_top=12 if before else 6, margin_bottom=4)
            label.add_css_class("heading")
            label.add_css_class("dim-label")
            row.set_header(label)
        else:
            row.set_header(None)

    def _on_row_activated(self, _listbox, row):
        self.stack.set_visible_child_name(row.page_id)
        self.content_page.set_title(row.page_title)
        self.split.set_show_content(True)

    @staticmethod
    def _link_row(title, subtitle, icon_name=None):
        # Plain text, not markup: titles like "Mouse & Touchpad" otherwise vanish.
        row = Adw.ActionRow(title=title, subtitle=subtitle, activatable=True, use_markup=False)
        if icon_name:
            row.add_prefix(Gtk.Image(icon_name=icon_name, pixel_size=32))
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        return row

    # --- Look -----------------------------------------------------------------------
    def _look_group(self):
        group = Adw.PreferencesGroup(title="Look", description="Colours and wallpaper")
        if self.interface:
            dark = Adw.SwitchRow(title="Dark mode")
            dark.set_active(self.interface.get_string("color-scheme") == "prefer-dark")
            dark.connect("notify::active", lambda row, _: self.interface.set_string(
                "color-scheme", "prefer-dark" if row.get_active() else "default"))
            group.add(dark)

            if self.interface.props.settings_schema.has_key("accent-color"):
                accent = Adw.ComboRow(title="Accent colour",
                                      model=Gtk.StringList.new([a.capitalize() for a in ui.ACCENTS]))
                current = self.interface.get_string("accent-color")
                accent.set_selected(ui.ACCENTS.index(current) if current in ui.ACCENTS else 4)
                accent.connect("notify::selected", lambda row, _: self.interface.set_string(
                    "accent-color", ui.ACCENTS[row.get_selected()]))
                group.add(accent)

        if self.background:
            self.wallpaper_choices = [(AUTO_WALLPAPER, None)] + ui.wallpapers()
            wall = Adw.ComboRow(title="Wallpaper",
                                subtitle="Automatic uses the light one in light mode",
                                model=Gtk.StringList.new([label for label, _ in self.wallpaper_choices]))
            wall.set_selected(self._current_wallpaper_index())
            wall.connect("notify::selected", self._on_wallpaper)
            group.add(wall)
        return group

    def _current_wallpaper_index(self):
        light = self.background.get_string("picture-uri")
        dark = self.background.get_string("picture-uri-dark")
        if light != dark:
            return 0
        for i, (_label, path) in enumerate(self.wallpaper_choices):
            if path and GLib.filename_to_uri(path) == light:
                return i
        return 0

    def _on_wallpaper(self, row, _pspec):
        _label, path = self.wallpaper_choices[row.get_selected()]
        if path is None:
            self.background.reset("picture-uri")
            self.background.reset("picture-uri-dark")
        else:
            uri = GLib.filename_to_uri(path)
            self.background.set_string("picture-uri", uri)
            self.background.set_string("picture-uri-dark", uri)

    # --- Animations -----------------------------------------------------------------
    def _animation_group(self):
        group = Adw.PreferencesGroup(
            title="Animations",
            description="Magic lamp and blur are on by default; the rest are there if you want more wiggle")
        if self.interface and self.interface.props.settings_schema.has_key("enable-animations"):
            master = Adw.SwitchRow(title="Animations", subtitle="Turn off for a calmer, faster desktop")
            self.interface.bind("enable-animations", master, "active", Gio.SettingsBindFlags.DEFAULT)
            group.add(master)

        if not self.shell:
            return group
        for uuid, title, blurb in ui.ANIMATION_EXTENSIONS:
            if not ui.extension_installed(uuid):
                continue
            row = Adw.SwitchRow(title=title, subtitle=blurb)
            row.set_active(self._extension_enabled(uuid))
            row.connect("notify::active", self._on_extension_toggled, uuid)
            prefs = Gtk.Button(icon_name="emblem-system-symbolic", valign=Gtk.Align.CENTER,
                               tooltip_text=f"{title} settings")
            prefs.add_css_class("flat")
            prefs.connect("clicked", lambda _b, u=uuid: self._open_extension_prefs(u))
            row.add_suffix(prefs)
            group.add(row)
        return group

    def _extension_enabled(self, uuid):
        return (uuid in self.shell.get_strv("enabled-extensions")
                and uuid not in self.shell.get_strv("disabled-extensions"))

    def _on_extension_toggled(self, row, _pspec, uuid):
        enabled = [u for u in self.shell.get_strv("enabled-extensions") if u != uuid]
        disabled = [u for u in self.shell.get_strv("disabled-extensions") if u != uuid]
        if row.get_active():
            enabled.append(uuid)
        else:
            disabled.append(uuid)
        self.shell.set_strv("enabled-extensions", enabled)
        self.shell.set_strv("disabled-extensions", disabled)

    def _open_extension_prefs(self, uuid):
        try:
            subprocess.Popen(["gnome-extensions", "prefs", uuid])
        except OSError:
            self.toasts.add_toast(Adw.Toast(title="Extension settings need the GNOME session"))

    # --- Terminal -------------------------------------------------------------------
    def _terminal_group(self):
        group = Adw.PreferencesGroup(title="Terminal")
        greet = Adw.SwitchRow(title="Greet me with uwufetch",
                              subtitle="Show the paw and system info in every new terminal")
        greet.set_active(fetch_greeting_enabled())
        greet.connect("notify::active", lambda row, _: set_fetch_greeting(row.get_active()))
        group.add(greet)

        kitty = self._link_row("UwTerminal look", "Edit ~/.config/kitty/kitty.conf")
        kitty.connect("activated", lambda *_: self._edit_config(
            Path(GLib.get_user_config_dir()) / "kitty" / "kitty.conf",
            Path("/etc/skel/.config/kitty/kitty.conf")))
        group.add(kitty)
        return group

    def _prompt_group(self):
        group = Adw.PreferencesGroup(
            title="Prompt",
            description="Starship, the line you type commands after. UwUbuntu starts with Pastel Powerline")
        if not shutil.which("starship"):
            group.add(Adw.ActionRow(title="Starship isn't installed"))
            return group
        self.preset_names = [name for name, _label in STARSHIP_PRESETS]
        style = Adw.ComboRow(title="Style",
                             subtitle="Replaces ~/.config/starship.toml (the old one is kept as .bak)",
                             model=Gtk.StringList.new([label for _name, label in STARSHIP_PRESETS]))
        preset = current_preset()
        style.set_selected(self.preset_names.index(preset) if preset in self.preset_names else 0)
        style.connect("notify::selected", self._on_preset)
        group.add(style)

        edit = self._link_row("Edit the prompt by hand", "Open ~/.config/starship.toml")
        edit.connect("activated", lambda *_: self._edit_config(STARSHIP_TOML, None))
        group.add(edit)
        return group

    def _on_preset(self, row, _pspec):
        name = self.preset_names[row.get_selected()]
        if name == current_preset() and STARSHIP_TOML.exists():
            return
        if STARSHIP_TOML.exists():
            shutil.copy2(STARSHIP_TOML, STARSHIP_TOML.with_suffix(".toml.bak"))
        STARSHIP_TOML.parent.mkdir(parents=True, exist_ok=True)
        result = subprocess.run(["starship", "preset", name, "-o", str(STARSHIP_TOML)],
                                capture_output=True, text=True)
        if result.returncode == 0:
            ui.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            STARSHIP_CHOICE.write_text(name + "\n", encoding="utf-8")
            message = "New prompt style! Open a new terminal to see it"
        else:
            message = "Couldn't switch the prompt style"
        self.toasts.add_toast(Adw.Toast(title=message))

    @staticmethod
    def _edit_config(config, default):
        if not config.exists():
            config.parent.mkdir(parents=True, exist_ok=True)
            # start from the UwUbuntu default so nothing changes until edited
            if default and default.exists():
                shutil.copy(default, config)
            else:
                config.touch()
        Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(str(config)), None)

    # --- Startup --------------------------------------------------------------------
    def _startup_group(self):
        group = Adw.PreferencesGroup(title="Startup")
        welcome = Adw.SwitchRow(title="Show UwU Welcome at login")
        welcome.set_active(ui.welcome_shows_at_login())
        welcome.connect("notify::active",
                        lambda row, _: ui.set_welcome_shows_at_login(row.get_active()))
        group.add(welcome)
        return group

    # --- System (GNOME Settings panels) ---------------------------------------------
    def _panel_group(self, title, panels):
        # No group title: the page header already names it, and libadwaita would read the
        # "&" in titles like "Display & Sound" as broken markup.
        group = Adw.PreferencesGroup(description="Opens the matching page of the system settings")
        for panel, row_title, subtitle in panels:
            row = self._link_row(row_title, subtitle)
            row.connect("activated", self._open_panel, panel)
            group.add(row)
        return group

    def _open_panel(self, _row, panel):
        try:
            subprocess.Popen(["gnome-control-center", panel])
        except OSError:
            self.toasts.add_toast(Adw.Toast(title="System settings aren't installed"))

    # --- Tools ----------------------------------------------------------------------
    def _tools_group(self):
        group = Adw.PreferencesGroup(title="UwUbuntu apps")
        for title, subtitle, icon, desktop_id in TOOLS:
            app = Gio.DesktopAppInfo.new(desktop_id)
            if app is None:
                continue
            row = self._link_row(title, subtitle, icon)
            row.connect("activated", lambda _r, a=app: a.launch([], None))
            group.add(row)
        return group

    def _show_about(self, *_):
        info = ui.os_release()
        about = Adw.AboutDialog(
            application_name=info.get("NAME", "UwUbuntu"),
            application_icon="uwubuntu-logo",
            version=info.get("VERSION", ""),
            comments="A fluffy Ubuntu remix (=^·ω·^=)",
            website=info.get("HOME_URL", ""),
            issue_url=info.get("BUG_REPORT_URL", ""),
            license_type=Gtk.License.GPL_3_0,
        )
        about.present(self)


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or SettingsWindow(self)
        window.present()


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
