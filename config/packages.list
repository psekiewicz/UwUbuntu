# Extra packages installed on top of ubuntu-desktop-minimal.
# One per line; '#' starts a comment. Packages missing from the archive are
# skipped with a warning instead of failing the build.

# Terminal: kitty is the default (see packages-remove.list for Ptyxis)
kitty
xdg-terminal-exec

# App store with Flatpak/Flathub instead of the Snap store
gnome-software
gnome-software-plugin-flatpak
flatpak

# GNOME extras (the animation extensions come from config/gnome-extensions.list)
gnome-tweaks
gnome-shell-extension-manager
gnome-shell-extension-appindicator
unzip

# Terminal fun
fastfetch
cowsay
fortune-mod
lolcat
sl

# Everyday goodies
ubuntu-restricted-addons
vlc
gimp
inkscape
krita
